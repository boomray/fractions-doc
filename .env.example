# ── Site gate ────────────────────────────────────────────────────────────────
# Shared password for previews. The site FAILS CLOSED when this is unset: every
# page returns 503. For the public launch set SITE_GATE=off explicitly; that is
# the only way the gate switches itself off.
SITE_PASSWORD=
SITE_GATE=

# ── Addresses ────────────────────────────────────────────────────────────────
# Where this site is served (canonical URLs, sitemap, OpenGraph cards).
NEXT_PUBLIC_SITE_URL=https://docs.fractions.fi
# Where "Open the app" and every app link point.
NEXT_PUBLIC_APP_URL=https://app.fractions.fi
